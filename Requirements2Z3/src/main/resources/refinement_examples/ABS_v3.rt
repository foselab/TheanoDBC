table abs
vardef
  sp,Real,input;
  br,Real,input;
  ssa,Bool,input;
  ssb,Bool,input;
  abs,Bool,output;
endvardef
reqdef
  sp>15 & br>8 & (ssa & ssb), abs;
endreqdef
endtable
table abs_prime
vardef
  sp,Real,input;
  br,Real,input;
  ssa,Bool,input;
  ssb,Bool,input;
  abs,Bool,output;
endvardef
reqdef
  sp>20 & br>9 & (ssa & ssb), abs;
endreqdef
endtable
