table Autopilot
vardef
	standby,Bool,input;
	apfail,Bool,input;
	supported,Bool,input;
	good,Bool,input;
	ap_transition_state,Bool,input;
	ap_nominal_state,Bool,input;
	ap_maneuver_state,Bool,input;
	ap_standby_state,Bool,input;
	MODE,Bool,output;
	request,Bool,output;
	pullup,Bool,output;
	STATE,Real,output;
endvardef
reqdef
	standby & ap_transition_state, STATE == 3.0;
	ap_transition_state & good & supported & !standby, STATE == 1.0;
	ap_nominal_state & !good & !standby, STATE == 2.0;
	ap_nominal_state & standby, STATE == 3.0;
	ap_maneuver_state & standby & good, STATE == 3.0;
	ap_maneuver_state & supported & good & !standby, STATE == 0.0;
	ap_standby_state & !standby & !apfail, STATE == 0.0;
	ap_standby_state & apfail, STATE == 2.0;
	!standby & !apfail & supported, pullup;
	!good, !pullup;
endreqdef
endtable
table Sensor
vardef
	MODE,Bool,input;
	request,Bool,input;
	limits,Bool,input;
	sen_nominal_state,Bool,input;
	sen_transition_state,Bool,input;
	sen_fault_state,Bool,input;
	good,Bool,output;
	SENSTATE,Real,output;
endvardef
reqdef
	sen_nominal_state & limits, SENSTATE == 2.0 & !good;
	sen_nominal_state & !request & !limits, SENSTATE == 1.0;
	sen_fault_state & !request & !limits, SENSTATE == 1.0;
	sen_transition_state & request & MODE, SENSTATE == 0.0;
endreqdef
endtable
