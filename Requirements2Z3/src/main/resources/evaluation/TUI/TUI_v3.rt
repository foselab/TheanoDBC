table TUI_v1
vardef
	reset,Bool,input;
	TL,Real,input;
	BL,Real,input;
	IC,Real,input;
	yout,Real,output;
	normal_yout,Real,output;
endvardef
reqdef
	BL <= IC & IC <= TL & reset, yout == IC;
	true, yout <= TL & yout >= BL;
	!reset & yout <= TL and yout >= BL, yout == normal_yout;
endreqdef
endtable
table TUI_v3
vardef
	reset,Bool,input;
	TL,Real,input;
	BL,Real,input;
	IC,Real,input;
	yout,Real,output;
	normal_yout,Real,output;
endvardef
reqdef
	BL <= IC & IC <= TL & reset, yout == IC;
	true, yout <= TL & yout >= BL;
	!reset & normal_yout <= TL & normal_yout >= BL, yout == normal_yout;
endreqdef
endtable
