table scc_v0
    vardef
        ac,Real,input;
        sp,Real,input;
        st,Real,input;
        th,Real,output;
    endvardef
    reqdef
        ac>0 & sp<st, th>0;
    endreqdef
endtable

table scc_v1
    vardef
        sp,Real,input;
        st,Real,input;
        th,Real,output;
    endvardef
    reqdef
        sp<st, th>10;
    endreqdef
endtable