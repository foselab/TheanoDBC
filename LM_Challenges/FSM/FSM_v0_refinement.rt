table FSM_system
vardef
	standby,Bool,input;
	apfail,Bool,input;
	supported,Bool,input;
	limits,Bool,input;
	pullup,Bool,output;
endvardef
reqdef
	limits & !standby & !apfail & supported, pullup;
endreqdef
endtable
table FSM_v0
vardef
