reqdef
	((((((((((standby & ap_transition) | (((ap_transition & good) & supported) & !standby)) | ((ap_nominal & !good) & !standby)) | (ap_nominal & standby)) | ((ap_maneuver & standby) & good)) | (((ap_maneuver & supported) & good) & !standby)) | ((ap_standby & !standby) & !apfail)) | (ap_standby & apfail)) & ((((sen_nominal & limits) | ((sen_nominal & !request) & !limits)) | ((sen_fault & !request) & !limits)) | ((sen_transition & request) & mode))) | !(((((((((((standby & ap_transition) -> ap_standby_out) & ((((ap_transition & good) & supported) & !standby) -> ap_nominal_out)) & (((ap_nominal & !good) & !standby) -> ap_maneuver_out)) & ((ap_nominal & standby) -> ap_standby_out)) & (((ap_maneuver & standby) & good) -> ap_standby_out)) & ((((ap_maneuver & supported) & good) & !standby) -> ap_transition_out)) & (((ap_standby & !standby) & !apfail) -> ap_transition_out)) & ((ap_standby & apfail) -> ap_maneuver_out)) & (((((sen_nominal & limits) -> sen_fault_out) & (((sen_nominal & !request) & !limits) -> sen_transition_out)) & (((sen_fault & !request) & !limits) -> sen_transition_out)) & (((sen_transition & request) & mode) -> sen_nominal_out))))), ((((((((((standby & ap_transition) -> ap_standby_out) & ((((ap_transition & good) & supported) & !standby) -> ap_nominal_out)) & (((ap_nominal & !good) & !standby) -> ap_maneuver_out)) & ((ap_nominal & standby) -> ap_standby_out)) & (((ap_maneuver & standby) & good) -> ap_standby_out)) & ((((ap_maneuver & supported) & good) & !standby) -> ap_transition_out)) & (((ap_standby & !standby) & !apfail) -> ap_transition_out)) & ((ap_standby & apfail) -> ap_maneuver_out)) & (((((sen_nominal & limits) -> sen_fault_out) & (((sen_nominal & !request) & !limits) -> sen_transition_out)) & (((sen_fault & !request) & !limits) -> sen_transition_out)) & (((sen_transition & request) & mode) -> sen_nominal_out)));
endreqdef
endtable
